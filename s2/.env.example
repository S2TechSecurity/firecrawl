# S2 Firecrawl overlay
# Never commit real secrets.

S2_AI_GATEWAY_API_KEY=
S2_AI_GATEWAY_BASE_URL=http://host.docker.internal:8787/v1
S2_AI_GATEWAY_MODEL=fast

# Conservative defaults for the Proxmox/internal-services worker.
NUM_WORKERS_PER_QUEUE=2
CRAWL_CONCURRENT_REQUESTS=3
MAX_CONCURRENT_JOBS=2
BROWSER_POOL_SIZE=2

# Keep the first deployment internal-only. Firecrawl's default self-host API
# is unauthenticated unless the DB-backed auth path is fully provisioned.
USE_DB_AUTHENTICATION=false
